{
  "name": "frontmatter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "node specs/harness/clean-architecture-report.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run arch && npm run spec",
    "budget": "echo 'No bundle budget configured yet \u2014 skipping'",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac-arm": "tauri build --target aarch64-apple-darwin",
    "tauri:build:mac-intel": "tauri build --target x86_64-apple-darwin",
    "tauri:build:mac-universal": "tauri build --target universal-apple-darwin",
    "spec": "node specs/harness/spec-report.mjs",
    "corpus": "node scripts/corpus-foreign.mjs verify",
    "tree": "node docs/build/build-tree.mjs",
    "doc": "node docs/build/assemble-tree.mjs docs/FRONTMATTER-RECORD.md",
    "pdf": "node docs/build/build-final.mjs",
    "refs": "node docs/build/check-refs.mjs",
    "record": "node docs/build/check-record.mjs",
    "decide": "node docs/build/build-prd-pdf.mjs docs/DECIDE.md frontmatter-DECIDE 'frontmatter' 'The decision layer'"
  },
