{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontmatter.local/specs/_schema/spec.schema.json",
  "title": "frontmatter spec file",
  "description": "Frontmatter contract for a file under specs/. Exactly one key is required: everything else must degrade. `id` is the path minus the specs/ prefix and the .md suffix, so identity never rots.",
  "type": "object",
  "required": ["spec"],
  "additionalProperties": false,
  "properties": {
    "spec": { "const": 1, "description": "Format version. The only required key." },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)+$",
      "description": "Stable identity, equal to the file path minus specs/ and .md. Never numeric-only."
    },
    "title": { "type": "string", "minLength": 3 },
    "type": { "enum": ["engine", "render", "protocol", "surface", "platform"] },
    "state": {
      "enum": ["draft", "ready", "in-progress", "implemented", "verified", "superseded"],
      "description": "Written forward ONLY by specs/harness/spec-report.mjs. A hand-written state is itself a drift finding."
    },
    "track": { "enum": ["R0", "T0", "T1", "T2", "T3", "T4", "T5", "T6"] },
    "prd_file": { "type": "string", "pattern": "^docs/.+\\.md$" },
    "prd_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prd_sections": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "governs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Globs of the code this spec owns. Two specs may never claim the same path."
    },
    "verify": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Shell commands. EXECUTED, never grepped. A check that greps source is a proxy and must say so."
    },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "budget": { "type": "integer", "minimum": 100, "maximum": 8000 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "owner": { "type": "string" },
    "superseded_by": { "type": "string" },
    "red_proof": {
      "type": "string",
      "description": "Path to the test that must FAIL against the unfixed code. Required to reach state: verified."
    },
    "corpus": { "type": "string" },
    "corpus_sha256": { "type": "string" },
    "defect_id": { "type": "string" },
    "profile": { "type": "string" },
    "carrier": {
      "enum": ["callout", "fence", "frontmatter", "none"],
      "description": "On-disk representation. `callout` = > [!kind]; `fence` = fenced code with an info string. See specs/render/fence-dispatch.md for why."
    },
    "reads_keys": { "type": "array", "items": { "type": "string" } },
    "writes_keys": { "type": "array", "items": { "type": "string" } },
    "writeback": { "enum": ["none", "splice"] },
    "degrade_to": { "type": "string" },
    "oracle": { "type": "string" },
    "transport": { "type": "string" },
    "tools": { "type": "array", "items": { "type": "string" } },
    "tool_cap": { "type": "integer", "maximum": 20 },
    "verdicts": { "type": "array", "items": { "type": "string" } },
    "refusals": { "type": "array", "items": { "type": "string" } },
    "screens": { "type": "array", "items": { "type": "string" } },
    "keys": { "type": "array", "items": { "type": "string" } },
    "empty_state": { "type": "string" },
    "gates": { "type": "array", "items": { "type": "string" } },
    "floor": { "type": "integer", "minimum": 1 },
    "x": {
      "type": "object",
      "description": "Every non-reserved key lives here. Keeps the reserved namespace closed so additionalProperties can stay false.",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "superseded" } }, "required": ["state"] },
      "then": { "required": ["superseded_by"] }
    },
    {
      "if": { "properties": { "state": { "const": "verified" } }, "required": ["state"] },
      "then": { "required": ["red_proof", "verify", "governs"] }
    },
    {
      "if": { "properties": { "state": { "enum": ["ready", "in-progress", "implemented", "verified"] } }, "required": ["state"] },
      "then": { "required": ["id", "title", "type", "governs", "verify", "prd_file", "prd_sections"] }
    }
  ]
}
