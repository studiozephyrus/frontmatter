# Tauri (Rust) build output. Cargo emits to ./target at the repo root
# when invoked via the Tauri CLI; src-tauri/target appears with a direct
# `cargo` invocation. Cover both.
target
src-tauri/target
src-tauri/gen/schemas
src-tauri/Cargo.lock
src-tauri/icons/android
src-tauri/icons/ios
