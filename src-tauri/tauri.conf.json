{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sgnk-md",
  "version": "0.1.0",
  "identifier": "ai.sgnk.md",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "https://md.sgnk.ai",
    "devUrl": "https://md.sgnk.ai"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "sgnk-md",
        "url": "https://md.sgnk.ai",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "© 2026 Sagnik Mitra",
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "shortDescription": "Your Markdown HQ — a GitHub-backed markdown workspace.",
    "longDescription": "sgnk-md is a markdown workspace with GitHub-backed storage, public share URLs, an interactive graph, AI assist, and a native macOS shell. Write in plain files, sync everywhere."
  }
}
